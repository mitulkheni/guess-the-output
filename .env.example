# Client-side environment key from Flagsmith: Environment Settings > SDK Keys.
# Use the Development key locally; the GitHub Pages build uses the Production key.
VITE_FLAGSMITH_ENVIRONMENT_ID=your_client_side_environment_key

# Self-hosted Flagsmith only (leave unset for Flagsmith Cloud):
# VITE_FLAGSMITH_API_URL=https://flagsmith.example.com/api/v1/
# VITE_FLAGSMITH_EVENTS_URL=https://events.flagsmith.example.com/
